# Public address of the website, used for links in customer inquiries and the sitemap.
# Leave empty during local development.
SITE_URL=

# Where the SQLite database and uploaded photos are stored (default: ./data).
# On a server, point this at a persistent disk and back it up.
DATA_DIR=

# Optional Telegram bot for updating the gold prices (see README → Telegram bot).
# The token comes from @BotFather. The secret is any random string of 16+ letters/digits.
# Owner IDs: Telegram user IDs allowed to change prices, comma-separated (the bot tells you yours).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_IDS=
